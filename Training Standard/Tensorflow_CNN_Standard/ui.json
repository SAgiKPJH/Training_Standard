{
  "Step1": {
    "Title": "Set Framework, Network and Using GPU",
    "Label": "Step 1: Set Network",
    "Parameters": {
      "SetNetworkName": {
         "Type": "select",
         "Label": "Network Name",
         "Prameter": "hyperparameter.network_name",
         "Options": [
             {"Label": "[ResNet] resnet50", "Value": "resnet50", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ResNet] resnet101", "Value": "resnet101", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ResNet] resnet152", "Value": "resnet152", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ResNet V2] resnet50_v2", "Value": "resnet50_v2", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ResNet V2] resnet101_v2", "Value": "resnet101_v2", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ResNet V2] resnet152_v2", "Value": "resnet152_v2", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[Inception] inceptionv3", "Value": "inceptionv3", "DefaultValues": {"hyperparameter.input_size": 299}},
             {"Label": "[Inception] inception_resnet_v2", "Value": "inception_resnet_v2", "DefaultValues": {"hyperparameter.input_size": 299}},
             {"Label": "[EfficientNet] efficientnet_b0", "Value": "efficientnet_b0", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[EfficientNet] efficientnet_b1", "Value": "efficientnet_b1", "DefaultValues": {"hyperparameter.input_size": 240}},
             {"Label": "[EfficientNet] efficientnet_b2", "Value": "efficientnet_b2", "DefaultValues": {"hyperparameter.input_size": 260}},
             {"Label": "[EfficientNet] efficientnet_b3", "Value": "efficientnet_b3", "DefaultValues": {"hyperparameter.input_size": 300}},
             {"Label": "[EfficientNet] efficientnet_b4", "Value": "efficientnet_b4", "DefaultValues": {"hyperparameter.input_size": 380}},
             {"Label": "[EfficientNet] efficientnet_b5", "Value": "efficientnet_b5", "DefaultValues": {"hyperparameter.input_size": 456}},
             {"Label": "[EfficientNet] efficientnet_b6", "Value": "efficientnet_b6", "DefaultValues": {"hyperparameter.input_size": 528}},
             {"Label": "[EfficientNet] efficientnet_b7", "Value": "efficientnet_b7", "DefaultValues": {"hyperparameter.input_size": 600}},
             {"Label": "[EfficientNet] efficientnet_v2_s", "Value": "efficientnet_v2_s", "DefaultValues": {"hyperparameter.input_size": 384}},
             {"Label": "[EfficientNet] efficientnet_v2_m", "Value": "efficientnet_v2_m", "DefaultValues": {"hyperparameter.input_size": 480}},
             {"Label": "[EfficientNet] efficientnet_v2_l", "Value": "efficientnet_v2_l", "DefaultValues": {"hyperparameter.input_size": 480}},
             {"Label": "[VGG] vgg16", "Value": "vgg16", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[VGG] vgg19", "Value": "vgg19", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[DenseNet] densenet121", "Value": "densenet121", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[DenseNet] densenet169", "Value": "densenet169", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[DenseNet] densenet201", "Value": "densenet201", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[MobileNet] mobilenet", "Value": "mobilenet", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[MobileNet] mobilenet_v2", "Value": "mobilenet_v2", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[MobileNet] mobilenet_v3_small", "Value": "mobilenet_v3_small", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[MobileNet] mobilenet_v3_large", "Value": "mobilenet_v3_large", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[NASNet] nasnet_mobile", "Value": "nasnet_mobile", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[NASNet] nasnet_large", "Value": "nasnet_large", "DefaultValues": {"hyperparameter.input_size": 331}},
             {"Label": "[Xception] xception", "Value": "xception", "DefaultValues": {"hyperparameter.input_size": 299}},
             {"Label": "[ConvNeXt] convnext_tiny", "Value": "convnext_tiny", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ConvNeXt] convnext_small", "Value": "convnext_small", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ConvNeXt] convnext_base", "Value": "convnext_base", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ConvNeXt] convnext_large", "Value": "convnext_large", "DefaultValues": {"hyperparameter.input_size": 224}},
             {"Label": "[ConvNeXt] convnext_xlarge", "Value": "convnext_xlarge", "DefaultValues": {"hyperparameter.input_size": 224}}
         ]
      },
      "SetUsingGPU": {
        "Type": "checkbox",
        "Label": "Using GPU",
        "Prameter": "hyperparameter.using_gpu"
      }
    }
  },
  "Step2": {
    "Title": "Set Hyperparameters",
    "Label": "Step 2: Set Hyperparameters",
    "Parameters": {
      "Epoch": { "Type": "integer", "Label": "Epoch", "Prameter": "hyperparameter.epoch"},
      "SaveEpoch": { "Type": "integer", "Label": "Save Epoch", "Prameter": "hyperparameter.save_epoch"},
      "BatchSize": { "Type": "integer", "Label": "Batch Size", "Prameter": "hyperparameter.batch_size"},
      "LearningRate": { "Type": "float", "Label": "Learning Rate", "Prameter": "hyperparameter.lr"}
    }
  },
  "Step3": {
    "Title": "Set Optimizer and Loss",
    "Label": "Step 3: Set Optimizer and Loss",

    "Parameters": {
      "Optimizer": {
        "Type": "select",
        "Label": "Optimizer",
        "Prameter": "hyperparameter.optimizer_name",
        "Options": [
          {"Label": "Adam", "Value": "Adam"},
          {"Label": "SGD", "Value": "SGD"},
          {"Label": "Adagrad", "Value": "Adagrad"},
          {"Label": "AdamW", "Value": "AdamW"},
          {"Label": "RMSprop", "Value": "RMSprop"}
        ]
      },
      "Loss": {
        "Type": "select",
        "Label": "Loss Function",
        "Prameter": "hyperparameter.criterion",
        "Options": [
          {"Label": "CrossEntropyLoss", "Value": "CrossEntropyLoss"},
          {"Label": "BCEWithLogitsLoss", "Value": "BCEWithLogitsLoss"},
          {"Label": "FocalLoss", "Value": "FocalLoss"},
          {"Label": "MSELoss", "Value": "MSELoss"},
          {"Label": "L1Loss", "Value": "L1Loss"},
          {"Label": "SmoothL1Loss", "Value": "SmoothL1Loss"},
          {"Label": "NLLLoss", "Value": "NLLLoss"},
          {"Label": "KLDivLoss", "Value": "KLDivLoss"},
          {"Label": "HuberLoss", "Value": "HuberLoss"},
          {"Label": "CosineEmbeddingLoss", "Value": "CosineEmbeddingLoss"},
          {"Label": "LabelSmoothingCrossEntropy", "Value": "LabelSmoothingCrossEntropy"}
        ]
      }
    }
  },
  "Step4": {
    "Title": "Data Augmentation",
    "Label": "Step 4: Data Augmentation",
    "Parameters": {
      "HorizontalFlip": {
        "Type": "checkbox",
        "Label": "Horizontal Flip",
        "Prameter": "hyperparameter.augmentation.horizontal_flip"
      },
      "VerticalFlip": {
        "Type": "checkbox",
        "Label": "Vertical Flip",
        "Prameter": "hyperparameter.augmentation.vertical_flip"
      },
      "_collapsed": {
        "Rotation": { "Type": "float", "Label": "Rotation (degrees, 0=off)", "Prameter": "hyperparameter.augmentation.rotation" },
        "Brightness": { "Type": "float", "Label": "Brightness (0=off, e.g. 0.2)", "Prameter": "hyperparameter.augmentation.brightness" },
        "Contrast": { "Type": "float", "Label": "Contrast (0=off, e.g. 0.2)", "Prameter": "hyperparameter.augmentation.contrast" },
        "Saturation": { "Type": "float", "Label": "Saturation (0=off, e.g. 0.2)", "Prameter": "hyperparameter.augmentation.saturation" },
        "Hue": { "Type": "float", "Label": "Hue (0=off, e.g. 0.1)", "Prameter": "hyperparameter.augmentation.hue" },
        "GaussianBlur": { "Type": "float", "Label": "Gaussian Blur (sigma, 0=off)", "Prameter": "hyperparameter.augmentation.gaussian_blur" },
        "RandomErasing": { "Type": "float", "Label": "Random Erasing (probability, 0=off)", "Prameter": "hyperparameter.augmentation.random_erasing" },
        "RandomAffine": { "Type": "float", "Label": "Random Affine (degrees, 0=off)", "Prameter": "hyperparameter.augmentation.random_affine" },
        "RandomPerspective": { "Type": "float", "Label": "Random Perspective (distortion, 0=off)", "Prameter": "hyperparameter.augmentation.random_perspective" },
        "RandomGrayscale": { "Type": "float", "Label": "Random Grayscale (probability, 0=off)", "Prameter": "hyperparameter.augmentation.random_grayscale" },
        "ShearRange": { "Type": "float", "Label": "Shear Range (0=off, e.g. 0.2)", "Prameter": "hyperparameter.augmentation.shear_range" },
        "ZoomRange": { "Type": "float", "Label": "Zoom Range (0=off, e.g. 0.2)", "Prameter": "hyperparameter.augmentation.zoom_range" },
        "WidthShift": { "Type": "float", "Label": "Width Shift (0=off, e.g. 0.1)", "Prameter": "hyperparameter.augmentation.width_shift" },
        "HeightShift": { "Type": "float", "Label": "Height Shift (0=off, e.g. 0.1)", "Prameter": "hyperparameter.augmentation.height_shift" }
      }
    }
  }
}
