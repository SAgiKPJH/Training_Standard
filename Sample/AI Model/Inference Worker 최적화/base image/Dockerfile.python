# Build stage for Python dependencies
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04 as builder

ENV TZ=Asia/Seoul

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    # Install prerequisites for adding PPA
    software-properties-common \
    && \
    # Add deadsnakes PPA for Python 3.10
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    # Install Python 3.10 (minimal required for Poetry)
    python3.10 \
    python3.10-venv \
    # Install dotnet runtime prerequisites
    wget \
    curl \
    apt-utils \
    ca-certificates \
    # Install gpu prerequisites
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Install tesseract 
    tesseract-ocr tesseract-ocr-kor && \
    # Install Microsoft package feed
    wget -q https://packages.microsoft.com/config/ubuntu/20.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb  && \
    dpkg -i packages-microsoft-prod.deb  && \
    rm packages-microsoft-prod.deb && \
    # Install .NET
    apt-get update && \
    apt-get install -y --no-install-recommends dotnet-runtime-7.0 && \
    # Cleanup
    rm -rf /var/lib/apt/lists/*

# Install pip for Python 3.10
RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python3.10 get-pip.py && \
    rm get-pip.py

# Set Python 3.10 as default
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3.10 /usr/bin/pip && \
    ln -sf /usr/bin/pip3.10 /usr/bin/pip3

COPY pyproject.toml poetry.lock ./

# Install poetry and dependencies
RUN pip install poetry==1.7.1 && \
    poetry config virtualenvs.create false && \
    poetry install --without dev --no-cache --no-interaction --no-root && \
    # Remove poetry cache to reduce size of docker image 
    rm -Rf ~/.cache/pypoetry

# Final runtime stage
FROM python:3.10-slim

ENV TZ=Asia/Seoul

# Copy Python and installed packages from builder
COPY --from=builder /usr/local/lib/python3.10 /usr/local/lib/python3.10
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy .NET runtime from builder
COPY --from=builder /usr/share/dotnet /usr/share/dotnet
COPY --from=builder /usr/bin/dotnet /usr/bin/dotnet

# Copy CUDA and cuDNN libraries from builder
COPY --from=builder /usr/local/cuda /usr/local/cuda
COPY --from=builder /usr/lib/x86_64-linux-gnu/libcuda* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libnvidia* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libcudnn* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/include/cudnn* /usr/include/

# Copy runtime dependencies from builder
COPY --from=builder /usr/bin/wget /usr/bin/wget
COPY --from=builder /usr/bin/curl /usr/bin/curl
COPY --from=builder /usr/share/ca-certificates /usr/share/ca-certificates
COPY --from=builder /usr/lib/x86_64-linux-gnu/libgl1-mesa-glx* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/lib/x86_64-linux-gnu/libglib2.0* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /usr/bin/tesseract /usr/bin/tesseract
COPY --from=builder /usr/share/tesseract-ocr /usr/share/tesseract-ocr
COPY --from=builder /usr/lib/x86_64-linux-gnu/libtesseract* /usr/lib/x86_64-linux-gnu/

# Set CUDA environment variables
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# Install only essential runtime dependencies that can't be copied
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    # Essential packages that need to be installed in runtime
    ca-certificates \
    && \
    # Cleanup
    rm -rf /var/lib/apt/lists/*


COPY smoke_test.py /usr/local/bin/smoke_test.py
CMD ["python", "/usr/local/bin/smoke_test.py"]