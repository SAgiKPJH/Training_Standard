# Multi-stage build for GPU-optimized Python module installation
# Stage 1: Build stage with all dependencies
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04 as builder

ENV TZ=Asia/Seoul

# Install system dependencies for building
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    curl \
    python3.10 \
    python3.10-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip3 install poetry==1.7.1

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Configure poetry to not create virtual environment
RUN poetry config virtualenvs.create false

# Install dependencies (excluding dev dependencies)
RUN poetry install --without dev --no-cache --no-interaction --no-root

# Stage 2: Runtime stage - minimal GPU image
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

# Install only runtime system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    # OpenCV dependencies
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Tesseract for OCR
    tesseract-ocr \
    tesseract-ocr-kor \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder stage
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Set working directory
WORKDIR /app

# Copy application code (if any)
# COPY . .

# Set environment variables
ENV PYTHONPATH=/usr/local/lib/python3.10/site-packages
ENV PYTHONUNBUFFERED=1

# Default command
CMD ["python3"]
